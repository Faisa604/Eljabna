{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aljabna-newspaper",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server/entry.ts",
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true
  }
}
